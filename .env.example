# ══════════════════════════════════════════════════════════════════════════════
#  AI-Assisted 3D Assembly Design — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model selection (gemini-2.0-flash is fast; gemini-1.5-pro is more capable)
GEMINI_MODEL=gemini-2.0-flash

# ── Skills AI ────────────────────────────────────────────────────────────────
# Profile name (maps to skills/<profile>.yaml)
SKILLS_PROFILE=engineering_3d_assembly

# Generation settings
SKILLS_TEMPERATURE=0.3
SKILLS_MAX_OUTPUT_TOKENS=2048
SKILLS_TOP_P=0.9

# ── Pipeline Orchestration ────────────────────────────────────────────────────
# How many top-K recommendations to request from the GNN
PIPELINE_TOP_K=5

# Max assembly graph size before the AI flags it as complex
PIPELINE_MAX_NODES=50

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Source folder for 3D models (absolute path)
SOURCE_3D_MODELS=/Users/mbp/Documents/MTECH/Sem4/Individual_project/AI_Assisted_3D_Assembly_Design/AI-Assisted-3D-Assembly-Design/Source_3d_models
